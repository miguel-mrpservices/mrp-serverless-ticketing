# --- TERRAFORM ---
# Ignore the local .terraform directory (plugins and modules)
.terraform/

# Ignore local state files (now handled by S3)
*.tfstate
*.tfstate.*

# Ignore sensitive variable files (CRITICAL: Never commit these!)
*.tfvars
*.tfvars.json

# Ignore local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform crash logs
crash.log
*.usage.log

# --- SYSTEM FILES ---
.DS_Store
Thumbs.db